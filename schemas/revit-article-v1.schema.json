{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revit24.com/schemas/revit-article-v1.schema.json",
  "title": "RevIt Article Package v1",
  "description": "Structured article handoff contract between ChatGPT/editorial generation and RevIt Publisher.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article",
    "vehicle",
    "cluster",
    "seo",
    "content",
    "internal_links",
    "related_articles",
    "sources",
    "structured_data",
    "publishing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "revit-article-v1"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_key",
        "title",
        "slug",
        "article_type",
        "summary",
        "excerpt"
      ],
      "properties": {
        "article_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 200,
          "description": "Stable unique external identifier used by RevIt Publisher."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 200
        },
        "article_type": {
          "type": "string",
          "enum": [
            "vehicle_hub",
            "pillar",
            "problem",
            "maintenance",
            "modification",
            "product",
            "fitment",
            "buying",
            "reliability",
            "comparison",
            "guide",
            "faq",
            "other"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "model",
        "generation",
        "trim",
        "start_year",
        "end_year",
        "engines"
      ],
      "properties": {
        "manufacturer": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "generation": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 50
        },
        "trim": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100
        },
        "start_year": {
          "type": ["integer", "null"],
          "minimum": 1900,
          "maximum": 2100
        },
        "end_year": {
          "type": ["integer", "null"],
          "minimum": 1900,
          "maximum": 2100
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_key",
        "name",
        "pillar_article_key",
        "parent_cluster_key"
      ],
      "properties": {
        "cluster_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pillar_article_key": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "parent_cluster_key": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_topic",
        "secondary_topics",
        "search_intent",
        "seo_title",
        "meta_description",
        "canonical",
        "index",
        "follow"
      ],
      "properties": {
        "primary_topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "secondary_topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "search_intent": {
          "type": "string",
          "enum": [
            "informational",
            "commercial",
            "transactional",
            "navigational",
            "mixed"
          ]
        },
        "seo_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "meta_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "canonical": {
          "type": "string",
          "oneOf": [
            { "const": "auto" },
            { "type": "string", "format": "uri" }
          ]
        },
        "index": {
          "type": "boolean"
        },
        "follow": {
          "type": "boolean"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro", "blocks", "faq"],
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/heading_block" },
              { "$ref": "#/$defs/paragraph_block" },
              { "$ref": "#/$defs/bullet_list_block" },
              { "$ref": "#/$defs/numbered_list_block" },
              { "$ref": "#/$defs/table_block" },
              { "$ref": "#/$defs/callout_block" },
              { "$ref": "#/$defs/quote_block" },
              { "$ref": "#/$defs/image_placeholder_block" }
            ]
          }
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "internal_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_article_key",
          "preferred_anchor",
          "relationship",
          "required"
        ],
        "properties": {
          "target_article_key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 200
          },
          "preferred_anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "relationship": {
            "type": "string",
            "enum": [
              "parent",
              "child",
              "pillar",
              "supporting",
              "related_problem",
              "related_maintenance",
              "related_modification",
              "related_product",
              "related_vehicle",
              "contextual"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "related_articles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_key", "relationship", "priority"],
        "properties": {
          "article_key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 200
          },
          "relationship": {
            "type": "string",
            "enum": [
              "parent",
              "child",
              "pillar",
              "supporting",
              "related_problem",
              "related_maintenance",
              "related_modification",
              "related_product",
              "related_vehicle",
              "contextual"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_name",
          "title",
          "url",
          "source_type",
          "purpose"
        ],
        "properties": {
          "source_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "technical_reference",
              "oem_documentation",
              "forum",
              "review",
              "news",
              "video",
              "other"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "structured_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["article", "breadcrumbs", "faq"],
      "properties": {
        "article": {
          "type": "boolean"
        },
        "breadcrumbs": {
          "type": "boolean"
        },
        "faq": {
          "type": "boolean"
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "author",
        "featured_image_id",
        "allow_comments"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "pending", "private"]
        },
        "author": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "featured_image_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "allow_comments": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "heading_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "text"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 2, "maximum": 4 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "paragraph_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "bullet_list_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "bullet_list" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "numbered_list_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "numbered_list" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "table_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "headers", "rows"],
      "properties": {
        "type": { "const": "table" },
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "callout_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "variant", "text"],
      "properties": {
        "type": { "const": "callout" },
        "variant": {
          "type": "string",
          "enum": ["info", "warning", "tip", "note"]
        },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "quote_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "quote" },
        "text": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string" }
      }
    },
    "image_placeholder_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "alt", "caption"],
      "properties": {
        "type": { "const": "image_placeholder" },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "suggested_filename": { "type": "string" }
      }
    }
  }
}
